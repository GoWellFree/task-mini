# ---- Backend ----
NODE_ENV=development
PORT=3000
# Comma-separated CORS allowlist, e.g. https://app.example.com,https://staging.example.com
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed to run migrations (npm run migrate) — the app itself never uses it.
# Supabase: Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Production only — required when NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_PATH=
TELEGRAM_WEBHOOK_SECRET=
JWT_SECRET=
ENABLE_DEV_AUTH=true

# ---- Frontend (put these in frontend/.env) ----
VITE_API_URL=http://localhost:3000
VITE_TELEGRAM_BOT_USERNAME=
